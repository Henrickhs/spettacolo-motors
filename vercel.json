{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/estoque.js": { "maxDuration": 30 } },
  "headers": [
    { "source": "/api/estoque", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ] }
  ]
}
